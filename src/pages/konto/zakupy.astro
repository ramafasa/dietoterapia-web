---
/**
 * Moje zakupy: /konto/zakupy (Task 6.4)
 *
 * Opłacone, nieanonimizowane zamówienia zalogowanej osoby (dowolna rola – RBAC wpuszcza na /konto/*
 * każdą zalogowaną, gościa odsyła na /logowanie?next=…). Najnowsze pierwsze.
 * - potwierdzenie wysłane → „Pobierz PDF” (GET /api/konto/zakupy/{itemId}/download → 302 na plik),
 * - opłacone, potwierdzenie jeszcze nie wysłane → „Potwierdzenie w drodze…” (plik wydawany dopiero po
 *   wysłaniu potwierdzenia umowy – art. 21 ust. 1 u.p.k.),
 * - brak zakupów → pusty stan z linkiem do /sklep (tylko przy FF_SKLEP; inaczej sam komunikat).
 * Bez FF_SKLEP (ścieżka dostarczenia). Okładki z kolekcji `ebooks` po slugu produktu.
 */
export const prerender = false

import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import { db } from '@/db'
import { isFeatureEnabled } from '@/lib/feature-flags'
import { ShopOrderRepository } from '@/lib/repositories/shopOrderRepository'
import { buildPurchaseViews, type PurchaseView } from '@/lib/shop/purchasesView'
import { dbErrorLog } from '@/lib/shop/safeLog'

Astro.response.headers.set('Cache-Control', 'no-store')

const user = Astro.locals.user
// RBAC już przekierowuje gościa – obrona w głąb
if (!user) return Astro.redirect(`/logowanie?next=${encodeURIComponent('/konto/zakupy')}`)

const entries = await getCollection('ebooks')
// Okładka dekoracyjna (alt="") – tytuł jest obok
const coverBySlug = new Map(entries.map((entry) => [entry.id, entry.data.cover]))

let purchases: PurchaseView<ImageMetadata>[] = []
let loadFailed = false
try {
  purchases = buildPurchaseViews(await new ShopOrderRepository(db).findPaidOrdersWithItemsForUser(user.id), coverBySlug)
} catch (error) {
  console.error('[/konto/zakupy] Error:', { userId: user.id, ...dbErrorLog(error) })
  loadFailed = true
  Astro.response.status = 500
}

const shopEnabled = isFeatureEnabled('SKLEP')
---

<Layout title="Moje zakupy | Paulina Maciak Dietetyk" description="Twoje zakupione e-booki" noindex disableTracking>
  <section class="min-h-[70vh] bg-neutral-light px-4 py-8 sm:py-16">
    <div class="container mx-auto max-w-3xl">
      <h1 class="mb-2 font-heading text-3xl font-bold text-neutral-dark sm:text-4xl">Moje zakupy</h1>
      <p class="mb-8 font-body text-neutral-dark/70">
        Tu znajdziesz wszystkie kupione e-booki. Pobieraj je, kiedy chcesz – zalecam zapisanie pliku na swoim
        urządzeniu.
      </p>

      {loadFailed ? (
        <div role="alert" class="rounded-xl bg-white p-8 text-center shadow-soft">
          <p class="mb-2 font-heading text-xl font-semibold text-neutral-dark">Nie udało się wczytać zakupów</p>
          <p class="font-body text-neutral-dark/70">Przepraszam, wystąpił chwilowy problem. Odśwież stronę za chwilę.</p>
        </div>
      ) : purchases.length === 0 ? (
        <div class="rounded-xl bg-white p-8 text-center shadow-soft sm:p-12">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10" aria-hidden="true">
            <svg class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <p class="mb-2 font-heading text-xl font-semibold text-neutral-dark">Nie masz jeszcze zakupów</p>
          <p class="mb-6 font-body text-neutral-dark/70">
            Kupione e-booki pojawią się tutaj. Zakup z innym adresem e-mail? Użyj linku „Wyślij link ponownie”.
          </p>
          <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
            {shopEnabled && <a href="/sklep" class="btn btn-primary inline-block">Przejdź do sklepu</a>}
            <a href="/sklep/wyslij-link" class="btn btn-secondary inline-block">Wyślij link ponownie</a>
          </div>
        </div>
      ) : (
        <ul class="space-y-6">
          {purchases.map((purchase) => (
            <li>
              <article class="rounded-xl bg-white p-6 shadow-soft sm:p-8" aria-labelledby={`order-${purchase.id}`}>
                <header class="mb-4 flex flex-col gap-1 border-b border-neutral-dark/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
                  <h2 id={`order-${purchase.id}`} class="font-heading text-lg font-semibold text-neutral-dark">
                    Zamówienie {purchase.orderNumber}
                  </h2>
                  <p class="font-body text-sm text-neutral-dark/70">
                    <time datetime={purchase.dateIso}>{purchase.dateLabel}</time>
                  </p>
                </header>

                {!purchase.ready && (
                  <p class="mb-4 rounded-lg bg-accent/10 p-4 font-body text-sm text-neutral-dark" role="status">
                    Potwierdzenie w drodze – plik będzie dostępny za chwilę. Odśwież stronę za kilka minut.
                  </p>
                )}

                <ul class="divide-y divide-neutral-dark/10">
                  {purchase.items.map((item) => (
                    <li class="flex flex-col gap-4 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center">
                      <div class="flex flex-1 items-center gap-4">
                        {item.cover ? (
                          <Image
                            src={item.cover}
                            alt=""
                            widths={[80, 160]}
                            sizes="80px"
                            class="h-auto w-16 flex-shrink-0 rounded-lg shadow-soft sm:w-20"
                          />
                        ) : (
                          <div class="flex h-24 w-16 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 sm:w-20" aria-hidden="true">
                            <span class="font-body text-xs font-semibold text-primary">PDF</span>
                          </div>
                        )}
                        <span class="font-body font-semibold text-neutral-dark">{item.title}</span>
                      </div>
                      {purchase.ready && (
                        <a
                          href={item.downloadHref}
                          rel="noreferrer"
                          class="btn btn-primary inline-block text-center"
                          aria-label={`Pobierz PDF: ${item.title}`}
                        >
                          Pobierz PDF
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>
