---
// Header component z nawigacją warunkową (marketing / dietitian / patient / customer)
import Avatar from './Avatar'
import LogoutButton from './LogoutButton'
import CartIcon from './sklep/CartIcon'
import { isFeatureEnabled } from '@/lib/feature-flags'
import { activeNavHref, desktopBreakpointFor, navTypeFor, panelNavLinks, patientZoneLink, type NavType } from '@/lib/navLinks'
import { db } from '@/db'
import { ShopOrderRepository } from '@/lib/repositories/shopOrderRepository'

const user = Astro.locals.user
const currentPath = Astro.url.pathname
const isStrefaPacjentaEnabled = isFeatureEnabled('STREFA_PACJENTA')
const isPzkEnabled = isFeatureEnabled('PZK')
const isSklepEnabled = isFeatureEnabled('SKLEP')

// Typ nawigacji z roli użytkownika (gość / nieznana rola → marketing)
const navType: NavType = navTypeFor(user?.role)

// „Moje e-booki” dla pacjentki z ≥1 opłaconym zamówieniem (błąd DB → false, nagłówek się renderuje)
const hasPaidShopOrder = navType === 'patient' && user
  ? await new ShopOrderRepository(db).hasPaidOrderForUser(user.id)
  : false

const panelLinks = panelNavLinks(navType, {
  pzkEnabled: isPzkEnabled,
  sklepEnabled: isSklepEnabled,
  hasPaidShopOrder,
})

// Marketing nav (do 8 linków + CTA + koszyk) mieści się w jednej linii dopiero od xl (1280px);
// poniżej – hamburger. Między xl a 2xl kontener ma 1216px, więc odstępy są ciaśniejsze,
// a „Strefa pacjenta” jest samą ikoną.
// Nawigacje panelu: pacjentka (do 5 linków z PZK i „Moje e-booki”) też od xl, dietetyk i klientka
// sklepu (3 krótkie linki) od lg – węższe ekrany dostają hamburger (wcześniej od md linki się łamały).
const isMarketingNav = navType === 'marketing'
const desktopBreakpoint = desktopBreakpointFor(navType)
const desktopNavClasses = isMarketingNav
  ? 'hidden xl:flex xl:items-center xl:flex-1 xl:ml-6 2xl:ml-8 xl:justify-end'
  : desktopBreakpoint === 'xl'
  ? 'hidden xl:flex xl:items-center xl:flex-1 xl:ml-8 xl:justify-between'
  : 'hidden lg:flex lg:items-center lg:flex-1 lg:ml-8 lg:justify-between'
const mobileOnlyClass = desktopBreakpoint === 'xl' ? 'xl:hidden' : 'lg:hidden'

// Smart redirect dla przycisku "Strefa pacjenta": gość → /logowanie (za FF), zalogowany → homeFor(role)
const patientZoneUrl = patientZoneLink(user, isStrefaPacjentaEnabled)

// Aktywny link: dopasowanie po pełnych segmentach ścieżki, najbardziej szczegółowy wygrywa
// (podstrony podświetlają rodzica, bez podwójnego podświetlenia Dashboard/Historia)
const MARKETING_HREFS = ['/', '/o-mnie', '/konsultacje', '/opinie', '/kontakt', '/sklep', '/pzk/kup', '/logowanie']
const activeHref = activeNavHref(
  currentPath,
  isMarketingNav ? MARKETING_HREFS : panelLinks.map((link) => link.href)
)
const isActive = (path: string) => path === activeHref
const ariaCurrent = (path: string) => (isActive(path) ? 'page' : undefined)

// Helper do generowania klas CSS dla linków
const getLinkClasses = (path: string) => {
  // nowrap – szerokość nawigacji liczona jest pod jedną linię (od progu desktop)
  const base = 'font-body transition-colors whitespace-nowrap'
  return isActive(path)
    ? `${base} text-primary font-semibold`
    : `${base} text-neutral-dark hover:text-primary`
}

// Helper dla mobile menu links
const getMobileLinkClasses = (path: string) => {
  const base = "block px-4 py-3 font-body rounded-lg transition-colors"
  return isActive(path)
    ? `${base} bg-primary/10 text-primary font-semibold`
    : `${base} text-neutral-dark hover:bg-neutral-light hover:text-primary`
}
---

<header class="sticky top-0 z-50 bg-white shadow-soft">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo (zawsze kieruje na /) -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-3 hover:opacity-90 transition-opacity">
          <img src="/images/logo.png" alt="Dietoterapia Paulina Maciak" class="h-16 w-auto" />
          <span class="font-heading font-bold text-2xl text-primary">Dietoterapia</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      {/* Dla zalogowanych: justify-between (linki po lewej, user info po prawej) */}
      {/* Dla niezalogowanych: justify-end (wszystko po prawej) */}
      <div class={desktopNavClasses}>

        <!-- Nav Links -->
        <div class={`flex items-center ${isMarketingNav ? 'space-x-4 2xl:space-x-6' : 'space-x-6'}`}>
          {panelLinks.map((link) => (
            <a href={link.href} aria-current={ariaCurrent(link.href)} class={`${getLinkClasses(link.href)}${link.emphasized ? ' font-bold' : ''}`}>
              {link.label}
            </a>
          ))}

          {navType === 'marketing' && (
            <>
              <a href="/" aria-current={ariaCurrent('/')} class={getLinkClasses('/')}>
                Home
              </a>
              <a href="/o-mnie" aria-current={ariaCurrent('/o-mnie')} class={getLinkClasses('/o-mnie')}>
                O mnie
              </a>
              <a href="/konsultacje" aria-current={ariaCurrent('/konsultacje')} class={getLinkClasses('/konsultacje')}>
                Konsultacje
              </a>
              <a href="/opinie" aria-current={ariaCurrent('/opinie')} class={getLinkClasses('/opinie')}>
                Opinie
              </a>
              <a href="/kontakt" aria-current={ariaCurrent('/kontakt')} class={getLinkClasses('/kontakt')}>
                Kontakt
              </a>
              {isSklepEnabled && (
                <a href="/sklep" aria-current={ariaCurrent('/sklep')} class={getLinkClasses('/sklep')}>
                  Sklep
                </a>
              )}
              {isPzkEnabled && (
                <a href="/pzk/kup" aria-current={ariaCurrent('/pzk/kup')} class={`${getLinkClasses('/pzk/kup')} font-bold`}>
                  Przestrzeń Zdrowej Kobiety
                </a>
              )}
              {patientZoneUrl && (
                <a href={patientZoneUrl} title="Strefa pacjenta" aria-current={ariaCurrent('/logowanie')} class="flex items-center gap-2 whitespace-nowrap font-body text-neutral-dark hover:text-primary transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="sr-only 2xl:not-sr-only">Strefa pacjenta</span>
                </a>
              )}
            </>
          )}
        </div>

        <!-- User Info + Logout (prawa strona) - tylko dla zalogowanych -->
        {!isMarketingNav && user && (
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-3">
              <Avatar
                firstName={user.firstName}
                lastName={user.lastName}
                size="md"
                client:load
              />
              <span class="font-body text-neutral-dark">
                {user.firstName}
              </span>
            </div>
            <LogoutButton client:load />
          </div>
        )}

        <!-- CTA Button (tylko dla marketing) -->
        {navType === 'marketing' && (
          <a
            href="/konsultacje#formularz"
            class="ml-4 2xl:ml-6 inline-flex items-center px-6 py-3 bg-accent text-white font-body font-semibold rounded-xl hover:scale-105 hover:shadow-soft-lg transition-all duration-200 flex-shrink-0"
          >
            Umów konsultację
          </a>
        )}
      </div>

      <!-- Koszyk (desktop + mobile, jedna wyspa) – marketing/pacjent/klientka i przy włączonym sklepie.
           Poniżej progu desktop koszyk stoi obok hamburgera. -->
      {isSklepEnabled && navType !== 'dietitian' && (
        <div class={`ml-auto flex-shrink-0 ${isMarketingNav ? 'xl:ml-2' : desktopBreakpoint === 'xl' ? 'xl:ml-4' : 'lg:ml-4'}`}>
          <CartIcon client:idle />
        </div>
      )}

      <!-- Mobile Menu Button -->
      <div class={mobileOnlyClass}>
        <button
          id="mobile-menu-button"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-neutral-dark hover:text-primary hover:bg-neutral-light transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Otwórz menu"
        >
          <!-- Hamburger Icon -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class={`hidden ${mobileOnlyClass}`}>
    <div class="px-4 pt-4 pb-6 space-y-3 bg-white shadow-soft-lg">

      {/* Mobile menu - PANEL (dietetyk / pacjent / klientka sklepu) */}
      {!isMarketingNav && user && (
        <>
          <!-- User Info Header -->
          <div class="flex items-center space-x-3 px-4 pb-4 border-b border-neutral-light">
            <Avatar
              firstName={user.firstName}
              lastName={user.lastName}
              size="lg"
              client:load
            />
            <div>
              <p class="font-body font-semibold text-neutral-dark">
                {user.firstName} {user.lastName}
              </p>
              <p class="font-body text-sm text-neutral-dark/70">
                {user.email}
              </p>
            </div>
          </div>

          <!-- Nav Links -->
          {panelLinks.map((link) => (
            <a href={link.href} aria-current={ariaCurrent(link.href)} class={`${getMobileLinkClasses(link.href)}${link.emphasized ? ' font-bold' : ''}`}>
              {link.label}
            </a>
          ))}

          <!-- Logout Button -->
          <div class="pt-4 border-t border-neutral-light">
            <LogoutButton isMobile={true} client:load />
          </div>
        </>
      )}

      {/* Mobile menu - MARKETING */}
      {navType === 'marketing' && (
        <>
          <a href="/" aria-current={ariaCurrent('/')} class={getMobileLinkClasses('/')}>
            Home
          </a>
          <a href="/o-mnie" aria-current={ariaCurrent('/o-mnie')} class={getMobileLinkClasses('/o-mnie')}>
            O mnie
          </a>
          <a href="/konsultacje" aria-current={ariaCurrent('/konsultacje')} class={getMobileLinkClasses('/konsultacje')}>
            Konsultacje
          </a>
          <a href="/opinie" aria-current={ariaCurrent('/opinie')} class={getMobileLinkClasses('/opinie')}>
            Opinie
          </a>
          <a href="/kontakt" aria-current={ariaCurrent('/kontakt')} class={getMobileLinkClasses('/kontakt')}>
            Kontakt
          </a>
          {isSklepEnabled && (
            <a href="/sklep" aria-current={ariaCurrent('/sklep')} class={getMobileLinkClasses('/sklep')}>
              Sklep
            </a>
          )}
          {isPzkEnabled && (
            <a href="/pzk/kup" aria-current={ariaCurrent('/pzk/kup')} class={`${getMobileLinkClasses('/pzk/kup')} font-bold`}>
              Przestrzeń Zdrowej Kobiety
            </a>
          )}
          {patientZoneUrl && (
            <a href={patientZoneUrl} aria-current={ariaCurrent('/logowanie')} class={getMobileLinkClasses('/logowanie')}>
              Strefa pacjenta
            </a>
          )}
          <a href="/konsultacje#formularz" class="block mt-4 px-6 py-3 bg-accent text-white font-body font-semibold text-center rounded-xl hover:bg-accent-dark transition-colors">
            Umów konsultację
          </a>
        </>
      )}
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button')
  const mobileMenu = document.getElementById('mobile-menu')

  mobileMenuButton?.addEventListener('click', () => {
    const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true'
    mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString())
    mobileMenuButton.setAttribute('aria-label', isExpanded ? 'Otwórz menu' : 'Zamknij menu')
    mobileMenu?.classList.toggle('hidden')
  })

  // Zamknij menu po kliknięciu w link (mobile)
  const mobileLinks = mobileMenu?.querySelectorAll('a')
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden')
      mobileMenuButton?.setAttribute('aria-expanded', 'false')
      mobileMenuButton?.setAttribute('aria-label', 'Otwórz menu')
    })
  })
</script>
